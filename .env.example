# Server
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
# Local development and the test suite must point at a database on this
# machine. `npm run dev` starts one in Docker and exports this for you; the
# value below is that container. A hosted URL here is refused by
# db/require-local-db.js - see npm run hosted:* for the deliberate way in.
DATABASE_URL=postgresql://postgres:devpass@127.0.0.1:5433/pepxdev
NODE_ENV=development

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# EasyPost shipping
EASYPOST_API_KEY=your_easypost_api_key_here
EASYPOST_WEBHOOK_SECRET=your_easypost_webhook_secret_here
SHIP_FROM_NAME=
SHIP_FROM_COMPANY=
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=
# Countries shipped to outside the U.S. (ISO codes). Blank = MX,CO,NL,GB,AE,TH.
# The checkout dropdown lists the same six; update checkout-intl.js too if you change it.
SHIPPING_COUNTRIES=
# FedEx sends international labels with a customs declaration. FedEx needs a
# phone number on the ship-from address, so set SHIP_FROM_PHONE too.
# Description printed for every item (max 45 chars; blank = product name).
CUSTOMS_ITEM_DESCRIPTION=
# 6-10 digit HS tariff code for the goods (optional but speeds clearance).
CUSTOMS_HS_TARIFF_NUMBER=
# Person certifying the declaration (defaults to SHIP_FROM_NAME).
CUSTOMS_SIGNER=
# merchandise | gift | documents | returned_goods | sample | other
CUSTOMS_CONTENTS_TYPE=merchandise
CUSTOMS_CONTENTS_EXPLANATION=
# return | abandon - what the carrier does if the parcel can't be delivered.
CUSTOMS_NON_DELIVERY=return

# Bootstrap admin account for local development
ADMIN_EMAIL=admin@pepx.test
ADMIN_PASSWORD=Admin123!
ADMIN_INSTITUTION=PepX Research

# COA file storage
# Absolute path to the directory where uploaded COA files are stored.
# Defaults to uploads/coas/ relative to the project root.
# For production, set this to a persistent volume path or use a cloud storage provider.
COA_UPLOAD_DIR=
