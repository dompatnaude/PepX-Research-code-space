# Server
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgres://username:password@localhost:5432/polar_pep
NODE_ENV=development

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# EasyPost shipping
EASYPOST_API_KEY=your_easypost_api_key_here
EASYPOST_WEBHOOK_SECRET=your_easypost_webhook_secret_here
SHIP_FROM_NAME=
SHIP_FROM_COMPANY=
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=

# Bootstrap admin account for local development
ADMIN_EMAIL=admin@pepx.test
ADMIN_PASSWORD=Admin123!
ADMIN_INSTITUTION=PepX Research

# COA file storage
# Absolute path to the directory where uploaded COA files are stored.
# Defaults to uploads/coas/ relative to the project root.
# For production, set this to a persistent volume path or use a cloud storage provider.
COA_UPLOAD_DIR=
