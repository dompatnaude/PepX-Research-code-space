{
  "name": "polar-pep-look-alike",
  "version": "1.0.0",
  "private": true,
  "description": "PepX Research storefront with backend auth",
  "main": "server.js",
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "vercel-build": "node scripts/migrate.js",
    "start": "npm run migrate && node server.js",
    "dev": "bash scripts/dev-local.sh",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:local:seed": "bash scripts/dev-local-seed.sh",
    "dev:local:down": "docker rm -f ${DEV_DB_CONTAINER:-pepx-dev-db}",
    "test": "node --test --require ./test/setup/no-production-db.js",
    "test:auth": "node --test --require ./test/setup/no-production-db.js test/auth/**/*.test.js",
    "pretest": "node test/setup/no-production-db.js",
    "hosted:server": "PEPX_HOSTED_DB_CONFIRM=production node server.js",
    "hosted:migrate": "PEPX_HOSTED_DB_CONFIRM=production node scripts/migrate.js",
    "hosted:backfill-coa-files": "PEPX_HOSTED_DB_CONFIRM=production node scripts/backfill-coa-files.js"
  },
  "dependencies": {
    "@easypost/api": "^8.9.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "resend": "^6.22.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "playwright": "^1.62.0"
  }
}
